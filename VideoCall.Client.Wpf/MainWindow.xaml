<Window x:Class="VideoCall.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VideoCall Client" Height="640" Width="1100">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="My name:" VerticalAlignment="Center"/>
                <TextBox x:Name="NameBox" Width="120" Margin="4,0,0,0"/>
                <Button x:Name="RegisterButton" Content="Register" Width="80" Margin="4,0,0,0" Click="RegisterButton_Click"/>
                <TextBlock Text="Call:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox x:Name="CalleeBox" Width="120" Margin="4,0,0,0"/>
                <Button x:Name="CallButton" Content="Call" Width="70" Margin="4,0,0,0" IsEnabled="False" Click="CallButton_Click"/>
                <Button x:Name="AcceptButton" Content="Accept" Width="70" Margin="4,0,0,0" IsEnabled="False" Click="AcceptButton_Click"/>
                <Button x:Name="RejectButton" Content="Reject" Width="70" Margin="4,0,0,0" IsEnabled="False" Click="RejectButton_Click"/>
                <Button x:Name="HangupButton" Content="Hangup" Width="70" Margin="4,0,0,0" IsEnabled="False" Click="HangupButton_Click"/>
            </StackPanel>
            <StackPanel x:Name="LossPanel" Orientation="Horizontal">
                <TextBlock Text="Source:" VerticalAlignment="Center"/>
                <ComboBox x:Name="SourceCombo" Width="110" Margin="4,0,0,0" SelectedIndex="0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Web camera"/>
                    <ComboBoxItem Content="Synthetic"/>
                    <ComboBoxItem Content="Video file"/>
                </ComboBox>
                <TextBlock Text="Server:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox x:Name="ServerBox" Width="110" Margin="4,0,0,0" Text="127.0.0.1"/>
                <TextBlock Text="Codec:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <ComboBox x:Name="CodecCombo" Width="90" Margin="4,0,0,0" SelectedIndex="0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="H.264"/>
                    <ComboBoxItem Content="JPEG"/>
                </ComboBox>
                <TextBlock Text="Simulate outgoing loss:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="0%" Width="44" Margin="2,0,0,0" FontWeight="Bold" Click="LossButton_Click"/>
                <Button Content="5%" Width="44" Margin="2,0,0,0" Click="LossButton_Click"/>
                <Button Content="10%" Width="44" Margin="2,0,0,0" Click="LossButton_Click"/>
                <Button Content="15%" Width="44" Margin="2,0,0,0" Click="LossButton_Click"/>
                <Button Content="20%" Width="44" Margin="2,0,0,0" Click="LossButton_Click"/>
                <Button Content="30%" Width="44" Margin="2,0,0,0" Click="LossButton_Click"/>
                <Button Content="50%" Width="44" Margin="2,0,0,0" Click="LossButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Not registered" FontWeight="Bold" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="Local (my camera)" FontWeight="Bold" Margin="0,0,0,4"/>
                <Image x:Name="LocalImage" Stretch="Uniform" Height="400"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Text="Remote (via protocol)" FontWeight="Bold" Margin="0,0,0,4"/>
                <Image x:Name="RemoteImage" Stretch="Uniform" Height="400"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
